# Get this from @BotFather on Telegram
TELEGRAM_TOKEN=

# Free tier at console.groq.com (no credit card needed)
GROQ_API_KEY=

# Optional: TypeSafe AI JEV API (typesafe.ai) — leave blank to use Groq fallback
JEV_API_KEY=

# Path to SQLite database file
DB_PATH=data.db

# Email — use any Gmail account to SEND the report
# GMAIL_SENDER    = the Gmail address you'll send FROM
# GMAIL_APP_PASSWORD = 16-char App Password from Google (NOT your login password)
#   How to get it: myaccount.google.com → Security → 2-Step Verification → App Passwords
GMAIL_SENDER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where the report is delivered (your inbox)
REPORT_EMAIL=rimjhimsmile16@gmail.com
